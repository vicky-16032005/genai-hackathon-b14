# Copy to .env and edit as needed. All optional — sensible defaults in src/config.py.
OLLAMA_BASE_URL=http://localhost:11434

# --- Generation (small + deployable) ---
# 'ollama'       -> fast local small model (great for the demo)
# 'transformers' -> self-contained HF model; deploys to HF Spaces / Streamlit Cloud (no Ollama)
LLM_PROVIDER=ollama
GEN_MODEL=qwen2.5:1.5b
HF_GEN_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# --- Embeddings / retriever (our fine-tuned model is deployable) ---
# 'st'     -> sentence-transformers; uses models/scheme-retriever (fine-tuned) if present, else base
# 'ollama' -> nomic-embed-text fallback
EMBED_PROVIDER=st
ST_EMBED_BASE=sentence-transformers/all-MiniLM-L6-v2
# ST_EMBED_MODEL=  (leave unset -> defaults to models/scheme-retriever)
EMBED_MODEL=nomic-embed-text

TOP_K=5
TEMPERATURE=0.1
NUM_PREDICT=700
